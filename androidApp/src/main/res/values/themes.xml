<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launch theme: Android 12's system splash (design hand-off › Splash). One background
      colour and the animated icon, no spinner. MainActivity holds it only until Home's first
      frame (from the local database, never the network), then plays the exit and switches to
      the app's own theme.
    -->
    <style name="Theme.Damask.Starting" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">450</item>
    </style>
</resources>
