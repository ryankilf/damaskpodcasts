# TLS termination for the search gateway. Caddy obtains and renews certificates automatically
# (Let's Encrypt, with ZeroSSL as its built-in fallback issuer), so port 80 must stay open for
# ACME challenges and the HTTP->HTTPS redirect.
#
# Deliberately NO `log` directive: Caddy's access log records the full URI, query string included,
# which would write users' search text to disk. The gateway keeps its own URL-free access log.
{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Only the API and the health check are public.
	@api path /v1/* /health
	handle @api {
		reverse_proxy gateway:8080
	}
	handle {
		respond 404
	}
}
