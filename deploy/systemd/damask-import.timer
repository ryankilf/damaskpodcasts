# Weekly, overnight. Podcast Index starts building the dump on Saturdays at 22:00 UTC and it has
# been published by about 23:30 UTC, so Sunday 03:30 UTC leaves a margin.
[Unit]
Description=Weekly Damask search index import

[Timer]
OnCalendar=Sun *-*-* 03:30:00 UTC
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
