# Copy to deploy/.env on the server (chmod 600). Never commit the real file.

# --- Public endpoint (Caddy) ---
# The hostname Caddy serves and gets a certificate for; Cloudflare DNS points at the VPS (DNS only,
# grey cloud). Also used by the gateway's /health certificate check.
PUBLIC_HOSTNAME=search.example.com
# Contact address for the certificate authority's expiry notices.
ACME_EMAIL=ops@example.com

# --- Meilisearch ---
# Long random string: openssl rand -hex 32
MEILI_MASTER_KEY=
# Any UUID v4: uuidgen | tr A-Z a-z
MEILI_SEARCH_KEY_UID=
# HMAC-SHA256(MEILI_MASTER_KEY, MEILI_SEARCH_KEY_UID): run ./search-key.sh to print it.
MEILI_SEARCH_KEY=
# Indexing limits, so the weekly import can't starve the gateway on a small box.
MEILI_MAX_INDEXING_MEMORY=1Gb
MEILI_MAX_INDEXING_THREADS=1

# --- Auth ---
# Your Supabase project URL. Tokens are verified against $SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://your-project.supabase.co
# The private build's bearer token. Leave empty to disable. Long random string.
PRIVATE_TOKEN=

# --- Private-build passthrough (off unless Podcast Index have agreed in writing) ---
PI_PASSTHROUGH=false
PI_KEY=
PI_SECRET=

DAMASK_VERSION=1.0.0
